    {
      "parameters": {
        "jsCode": "// Entrada: se espera que venga un campo fecha_solicitada y los horarios por día\nconst item = $json;\n\n// Obtener fecha solicitada\nconst fechaSolicitada = new Date(item.fecha_solicitada);\nif (isNaN(fechaSolicitada.getTime())) {\n  throw new Error(\"La fecha solicitada no es válida\");\n}\n\n// Mapear días en español\nconst diasSemana = [\n  \"Domingo\", \"Lunes\", \"Martes\", \"Miercoles\", \"Jueves\", \"Viernes\", \"Sabado\"\n];\n\nconst diaSemana = diasSemana[fechaSolicitada.getDay()]; // ej: \"Lunes\"\nconst horaSolicitada = fechaSolicitada.getHours() + fechaSolicitada.getMinutes() / 60;\n\n// Obtener horario del día correspondiente\nlet horarioDelDia = item[diaSemana];\nlet estaAbierto = false;\nlet mensaje = \"\";\n\n// Si no hay horario configurado para ese día\nif (!horarioDelDia || horarioDelDia.toLowerCase().includes(\"cerrado\")) {\n  mensaje = `El ${diaSemana} está cerrado.`;\n} else {\n  // Extraer rango de horario \"De 9:30 hs a 18:30 hs\"\n  const match = horarioDelDia.match(/De (\\d{1,2}):(\\d{2}) hs a (\\d{1,2}):(\\d{2}) hs/);\n  \n  if (match) {\n    const horaInicio = parseInt(match[1]) + parseInt(match[2]) / 60;\n    const horaFin = parseInt(match[3]) + parseInt(match[4]) / 60;\n\n    if (horaSolicitada >= horaInicio && horaSolicitada <= horaFin) {\n      estaAbierto = true;\n      mensaje = `El ${diaSemana} a las ${fechaSolicitada.toLocaleTimeString(\"es-AR\", {hour: '2-digit', minute:'2-digit'})} está disponible.`;\n    } else {\n      mensaje = `El ${diaSemana} está fuera de horario (${horarioDelDia}).`;\n    }\n  } else {\n    mensaje = `No se pudo interpretar el horario para ${diaSemana}.`;\n  }\n}\n\n// Salida para n8n\nreturn [{\n  json: {\n    diaConsultado: diaSemana,\n    fechaSolicitada: fechaSolicitada.toISOString(),\n    horaConsultada: fechaSolicitada.toLocaleTimeString(\"es-AR\", {hour: '2-digit', minute:'2-digit'}),\n    horarioDelDia,\n    estaAbierto,\n    mensaje\n  }\n}];\n"
      },
