    {
      "parameters": {
        "jsCode": "// Validar si la fecha es pasada\nconst fechaTexto = $input.first().json.Fecha;\nconst fechaInput = new Date(fechaTexto);\nconst fechaActual = new Date();\n\n// Resetear horas para comparar solo fechas\nfechaActual.setHours(0, 0, 0, 0);\nfechaInput.setHours(0, 0, 0, 0);\n\nif (fechaInput < fechaActual) {\n  return [{\n    json: {\n      valida: false,\n      resultado: \"La fecha ingresada es pasada, por favor ingrese una fecha válida\",\n      fecha: fechaTexto\n    }\n  }];\n}\n\n// Si la fecha es válida, procesamos\nconst fechaOriginal = new Date($input.first().json.Fecha);\n\n// Formatear fecha y extraer componentes\nconst dd = String(fechaOriginal.getDate()).padStart(2, '0');\nconst mm = String(fechaOriginal.getMonth() + 1).padStart(2, '0');\nconst yyyy = fechaOriginal.getFullYear();\nconst HH = String(fechaOriginal.getHours()).padStart(2, '0');\nconst min = String(fechaOriginal.getMinutes()).padStart(2, '0');\n\n// Obtener día de la semana\nconst diasSemana = [\"domingo\", \"lunes\", \"martes\", \"miércoles\", \"jueves\", \"viernes\", \"sábado\"];\nconst diaSemana = diasSemana[fechaOriginal.getDay()];\n\nreturn [{\n  json: {\n    valida: true,\n    fechaFormateada: `${dd}/${mm}/${yyyy} ${HH}:${min}`,\n    hora: `${HH}:${min}`,\n    diaSemana: diaSemana,\n    fechaOriginal: fechaTexto\n  }\n}];\n"
      },
