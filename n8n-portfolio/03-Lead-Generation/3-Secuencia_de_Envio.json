      ],
      "parameters": {
        "jsCode": "return [{json:{googleSheetsId:'REEMPLAZAR_ID_SHEET',evolutionApiUrl:'REEMPLAZAR_URL_EVOLUTION',evolutionApiKey:'REEMPLAZAR_KEY_EVOLUTION',evolutionInstance:'REEMPLAZAR_INSTANCIA',diasEntreMsg1yMsg2:3,diasEntreMsg2yMsg3:5}}];"
      }
    },
    {
      "id": "aa000001-0001-0001-0001-000000000003",
      "name": "Obtener Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        300
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.googleSheetsId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      }
    },
    {
      "id": "aa000001-0001-0001-0001-000000000004",
      "name": "Filtrar por Timing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const cfg=$('Configuracion').item.json;\nconst hoy=new Date();\nconst out=[];\nfor(const item of $input.all()){\n  const l=item.json;\n  if(l.status==='listo_para_enviar'&&(l.email||l.telefono)){\n    out.push({json:{...l,mensaje_a_enviar:'msg1',config:cfg}});\n  }else if(l.status==='msg1_enviado'&&l.fecha_msg1){\n    if(Math.floor((hoy-new Date(l.fecha_msg1))/86400000)>=cfg.diasEntreMsg1yMsg2)\n      out.push({json:{...l,mensaje_a_enviar:'msg2',config:cfg}});\n  }else if(l.status==='msg2_enviado'&&l.fecha_msg2){\n    if(Math.floor((hoy-new Date(l.fecha_msg2))/86400000)>=cfg.diasEntreMsg2yMsg3)\n      out.push({json:{...l,mensaje_a_enviar:'msg3',config:cfg}});\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "aa000001-0001-0001-0001-000000000005",
      "name": "Procesar de a 1",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "aa000001-0001-0001-0001-000000000006",
      "name": "Preparar Contenido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "jsCode": "const l=$json;\nconst m=l.mensaje_a_enviar;\nreturn [{json:{...l,\n  email_asunto:m==='msg1'?l.email_msg1_asunto:m==='msg2'?l.email_msg2_asunto:l.email_msg3_asunto,\n  email_cuerpo:m==='msg1'?l.email_msg1_cuerpo:m==='msg2'?l.email_msg2_cuerpo:l.email_msg3_cuerpo,\n  wa_texto:m==='msg1'?l.whatsapp_msg1:m==='msg2'?l.whatsapp_msg2:l.whatsapp_msg3,\n  nuevo_status:m==='msg1'?'msg1_enviado':m==='msg2'?'msg2_enviado':'msg3_enviado',\n  fecha_hoy:new Date().toISOString().split('T')[0]\n}}];"
      }
    },
    {
      "id": "aa000001-0001-0001-0001-000000000007",
      "name": "Enviar Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1560,
        300
      ],
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.email_asunto }}",
        "message": "={{ $json.email_cuerpo }}",
        "options": {}
      }
    },
    {
      "id": "aa000001-0001-0001-0001-000000000008",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.evolutionApiUrl + '/message/sendText/' + $json.config.evolutionInstance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.config.evolutionApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
