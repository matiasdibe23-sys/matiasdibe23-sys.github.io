    {
      "parameters": {
        "jsCode": "// ── Parse AI response & prepare all downstream data in one pass ──\nconst aiResponse = $input.first().json;\nconst telegramMsg = $('Telegram Trigger').first().json;\n\n// ── Extract Telegram context ──\nconst chatId    = telegramMsg.message.chat.id;\nconst messageId = telegramMsg.message.message_id;\nconst leadText  = telegramMsg.message.text || '';\nconst sender    = [\n  telegramMsg.message.from?.first_name || '',\n  telegramMsg.message.from?.last_name  || ''\n].join(' ').trim() || 'Desconocido';\n\n// ── Extraer texto crudo del LLM (compatible con todas las versiones) ──\n// \"Message a Model\" (nueva):   output[0].content[0].text\n// Intermedia:                  content[0].text\n// \"Chat Complete\" (antigua):   message.content\nconst raw = aiResponse.output?.[0]?.content?.[0]?.text\n         ?? aiResponse.content?.[0]?.text\n         ?? aiResponse.message?.content\n         ?? '';\n\n// ── Parse JSON del LLM (con fallback) ──\nlet parsed;\ntry {\n  const cleaned = raw\n    .replace(/```json\\n?/gi, '')\n    .replace(/```\\n?/gi, '')\n    .trim();\n  parsed = JSON.parse(cleaned);\n\n  if (typeof parsed.qualified !== 'boolean' || !parsed.decision || !parsed.reasoning) {\n    throw new Error('Faltan claves en la respuesta del LLM');\n  }\n} catch (e) {\n  parsed = {\n    qualified : false,\n    decision  : 'ERROR_PARSE',\n    reasoning : 'No pude analizar la respuesta. Error: ' + e.message + ' | Raw: ' + raw.slice(0, 100)\n  };\n}\n\n// ── Construir respuesta de Telegram ──\nconst emoji     = parsed.qualified ? '✅' : '❌';\nconst badge     = parsed.qualified ? '🟢 CUALIFICADO' : '🔴 NO CUALIFICADO';\nconst replyText = `${emoji} *${badge}*\\n\\n${parsed.reasoning}\\n\\n_— Lead Qualifier Bot_`;\n\nconst timestamp = new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid' });\n\nreturn [{\n  json: {\n    chatId,\n    messageId,\n    leadText,\n    sender,\n    qualified : parsed.qualified,\n    decision  : parsed.decision,\n    reasoning : parsed.reasoning,\n    replyText,\n    timestamp\n  }\n}];\n"
      },
